<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/27"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="teutonic.gestionprotocolos.AnalysisCardController"
        prefWidth="250"
        prefHeight="150"
        spacing="10"
        styleClass="analysis-card"
        stylesheets="@styles.css">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <Label fx:id="nombreLabel"
           text="Nombre del análisis"
           styleClass="analysis-card-title"/>

    <Label fx:id="determinacionesLabel"
           text="Determinaciones"
           wrapText="true"
           styleClass="analysis-card-description"/>

    <Label fx:id="muestraLabel"
           text="Próx. muestra N° 000"
           styleClass="analysis-card-sample"/>

</VBox>