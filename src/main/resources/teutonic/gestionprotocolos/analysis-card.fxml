<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="teutonic.gestionprotocolos.Controller.AnalysisCardController"
      fx:id="card"
      styleClass="analysis-card"
      prefWidth="310"
      prefHeight="188"
      spacing="10">

    <padding>
        <Insets top="24"
                right="24"
                bottom="22"
                left="24"/>
    </padding>

    <Label fx:id="nombreLabel"
           styleClass="analysis-card-title"
           wrapText="true"/>

    <Label fx:id="determinacionesLabel"
           styleClass="analysis-card-description"
           wrapText="true"/>

    <VBox VBox.vgrow="ALWAYS"/>

    <Label fx:id="muestraLabel"
           styleClass="analysis-card-sample"/>

</VBox>