<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/27"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="20"
      styleClass="catalogo-root"
      stylesheets="@styles.css">

    <!-- Encabezado -->
    <VBox spacing="5">
        <Label text="Gestión de catálogos"
               styleClass="catalogo-title"/>

        <Label text="Administrá las granjas, sectores y clientes del laboratorio."
               styleClass="catalogo-subtitle"/>
    </VBox>

    <!-- Selector de catálogo -->
    <HBox spacing="10" styleClass="catalogo-selector">

        <Button fx:id="granjasButton"
                text="Granjas"
                styleClass="catalogo-tab"/>

        <Button fx:id="sectoresButton"
                text="Sectores"
                styleClass="catalogo-tab"/>

        <Button fx:id="clientesButton"
                text="Clientes"
                styleClass="catalogo-tab"/>

    </HBox>

    <!-- Área principal -->
    <HBox spacing="18" VBox.vgrow="ALWAYS">

        <!-- Panel de tabla -->
        <VBox spacing="15"
              HBox.hgrow="ALWAYS"
              styleClass="catalogo-panel">

            <!-- Barra de búsqueda y acción -->
            <HBox spacing="12" alignment="CENTER_LEFT">

                <TextField fx:id="busquedaField"
                           promptText="Buscar por nombre..."
                           styleClass="catalogo-search"
                           HBox.hgrow="ALWAYS"/>

                <Button fx:id="nuevoButton"
                        text="+ Nuevo registro"
                        styleClass="primary-button"/>

            </HBox>

            <!-- Tabla -->
            <TableView fx:id="catalogoTable"
                       VBox.vgrow="ALWAYS"
                       styleClass="catalogo-table">

                <placeholder>
                    <Label text="No hay registros para mostrar."/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="nombreColumn"
                                 text="Nombre"
                                 prefWidth="350"/>

                    <TableColumn fx:id="estadoColumn"
                                 text="Estado"
                                 prefWidth="130"/>

                    <TableColumn fx:id="accionesColumn"
                                 text="Acciones"
                                 prefWidth="180"/>
                </columns>

            </TableView>

            <!-- Mensajes de operación -->
            <Label fx:id="mensajeGeneralLabel"
                   text=""
                   wrapText="true"
                   styleClass="catalogo-message"/>

        </VBox>

        <!-- Panel lateral de alta y edición -->
        <VBox fx:id="formularioPanel"
              spacing="15"
              visible="false"
              managed="false"
              prefWidth="300"
              minWidth="280"
              styleClass="catalogo-form-panel">

            <VBox spacing="5">
                <Label fx:id="formularioTituloLabel"
                       text="Nuevo registro"
                       styleClass="catalogo-form-title"/>

                <Label text="Completá los datos del registro."
                       styleClass="catalogo-subtitle"/>
            </VBox>

            <Separator/>

            <VBox spacing="8">
                <Label text="Nombre"
                       styleClass="catalogo-field-label"/>

                <TextField fx:id="nombreField"
                           promptText="Ingresá un nombre..."
                           styleClass="catalogo-input"/>
            </VBox>

            <CheckBox fx:id="activoCheckBox"
                      text="Registro activo"
                      selected="true"/>

            <Label fx:id="mensajeFormularioLabel"
                   text=""
                   wrapText="true"
                   styleClass="catalogo-message"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="10">
                <Button fx:id="cancelarButton"
                        text="Cancelar"
                        styleClass="secondary-button"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity"/>

                <Button fx:id="guardarButton"
                        text="Guardar"
                        styleClass="primary-button"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity"/>
            </HBox>

        </VBox>

    </HBox>

</VBox>