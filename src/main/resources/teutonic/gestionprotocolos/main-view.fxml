<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>


<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Separator?>
<BorderPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="teutonic.gestionprotocolos.Controller.MainController"
            stylesheets="@styles.css">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar"
              prefWidth="240"
              spacing="6">

            <padding>
                <Insets top="28"
                        right="16"
                        bottom="24"
                        left="16"/>
            </padding>

            <!-- IDENTIDAD DEL SISTEMA -->
            <VBox spacing="3"
                  styleClass="sidebar-header">

                <Label text="LABORATORIO"
                       styleClass="sidebar-title"/>

                <Label text="Gestión de Protocolos"
                       styleClass="sidebar-subtitle"/>

            </VBox>

            <Region prefHeight="18"/>

            <!-- NAVEGACIÓN PRINCIPAL -->
            <VBox spacing="4">

                <Button text="▣   Nuevo análisis"
                        styleClass="sidebar-button, sidebar-button-active"
                        maxWidth="Infinity"/>

                <Button text="☷   Control de pollo"
                        styleClass="sidebar-button"
                        maxWidth="Infinity"/>

                <Button text="⌕   Buscar"
                        styleClass="sidebar-button"
                        maxWidth="Infinity"/>

                <Button text="▤   Informes"
                        styleClass="sidebar-button"
                        maxWidth="Infinity"/>

                <Button text="▱   Catálogos"
                        styleClass="sidebar-button"
                        maxWidth="Infinity"/>

            </VBox>

            <!-- ESPACIO FLEXIBLE -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- ACCIONES SECUNDARIAS -->
            <VBox spacing="4">

                <Separator styleClass="sidebar-separator"/>

                <Button text="↓   Respaldo"
                        styleClass="sidebar-button sidebar-button-secondary"
                        maxWidth="Infinity"/>

            </VBox>

        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>

        <BorderPane styleClass="main-content">

            <!-- HEADER -->
            <top>

                <VBox spacing="6">

                    <padding>
                        <Insets top="34"
                                right="40"
                                bottom="26"
                                left="40"/>
                    </padding>

                    <Label text="Nuevo análisis"
                           styleClass="page-title"/>

                    <Label text="Elegí el formulario para comenzar un nuevo análisis."
                           styleClass="page-subtitle"/>

                </VBox>

            </top>

            <!-- ÁREA DE TRABAJO -->
            <center>

                <VBox spacing="16">

                    <padding>
                        <Insets top="10"
                                right="40"
                                bottom="40"
                                left="40"/>
                    </padding>

                    <Label text="MUESTRAS DE PRODUCTO"
                           styleClass="section-title"/>

                    <GridPane fx:id="cardsGrid"
                              hgap="15"
                              vgap="15"/>

                </VBox>

            </center>

        </BorderPane>

    </center>

</BorderPane>